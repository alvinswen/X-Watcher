# ============================================================
# X-watcher 环境配置
# ============================================================

# ========== LLM 配置 ==========
# 提供商优先级列表（逗号分隔），支持：openrouter, minimax, deepseek, zhipu, moonshot, custom
# LLM_PROVIDERS=openrouter,deepseek

# 各提供商 API Key（仅需配置 LLM_PROVIDERS 中列出的提供商）
# LLM_OPENROUTER_API_KEY=sk-or-xxx
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_ZHIPU_API_KEY=xxx
# LLM_MOONSHOT_API_KEY=sk-xxx
# LLM_MINIMAX_API_KEY=xxx

# 可选：覆盖默认模型和 base_url
# LLM_OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# LLM_DEEPSEEK_MODEL=deepseek-chat
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ========== X 平台 API 配置 ==========
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_BASE_URL=https://api.twitterapi.io/twitter

# ========== 抓取器配置 ==========
SCRAPER_ENABLED=true
SCRAPER_INTERVAL=43200
SCRAPER_USERNAMES=user1,user2,user3
SCRAPER_LIMIT=100

# ========== 数据库配置 ==========
DATABASE_URL=sqlite:///./news_agent.db

# ========== 日志配置 ==========
LOG_LEVEL=INFO

# ========== Prometheus 监控 ==========
PROMETHEUS_ENABLED=true

# ========== 管理员 API 配置 ==========
ADMIN_API_KEY=your_admin_api_key_here

# ========== JWT 认证配置 ==========
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_EXPIRE_HOURS=24

# ========== 自动摘要配置 ==========
AUTO_SUMMARIZATION_ENABLED=true
AUTO_SUMMARIZATION_WAIT_FOR_COMPLETION=false
AUTO_SUMMARIZATION_BATCH_SIZE=50

# ========== Feed API 配置 ==========
FEED_MAX_TWEETS=200
