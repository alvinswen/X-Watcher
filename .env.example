# ============================================================
# X-watcher 环境配置
# ============================================================

# ========== X 平台 API 配置 ==========
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_BASE_URL=https://api.twitterapi.io/twitter

# ========== 抓取器配置 ==========
SCRAPER_LIMIT=30

# ========== 数据层配置 ==========
# file 文件层（数据落 XWATCHER_DATA_ROOT；PostgreSQL 已于 2026-06-24 下线）
XWATCHER_DATA_ROOT=data_migrated

# ========== 日志配置 ==========
LOG_LEVEL=INFO

# ========== Prometheus 监控 ==========
PROMETHEUS_ENABLED=true

# ========== MCP Action Guard（动作级白名单 · 事前拦截）==========
# 按工具收紧允许的 action；留空或不设该变量 = 允许全部（行为不变），需收紧时取消注释并填值。
# 与 MCP_SCRAPE_ENABLED（整体开关）并存：任一拒绝即拒绝。
# manage_follows 合法 action：list,add,update,deactivate
# MCP_FOLLOWS_ALLOWED_ACTIONS=list,add,update,deactivate
# trigger_scrape / trigger_backfill 的 action 固定为 "scrape"（无 action 参数）；
# 收紧示例：设为不含 scrape 的值即禁用该工具的触发。
# MCP_TRIGGER_SCRAPE_ALLOWED_ACTIONS=scrape
# MCP_TRIGGER_BACKFILL_ALLOWED_ACTIONS=scrape

# ========== 管理员 API 配置 ==========
ADMIN_API_KEY=your_admin_api_key_here

# ========== JWT 认证配置 ==========
# 必填：留空启动会被强度校验拦下（禁默认值 / 非空 / >=32 字符）。
# 生成强随机密钥后填入：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24

# ========== Feed API 配置 ==========
FEED_MAX_TWEETS=200

# ========== TwitterAPI.io 余额告警阈值 ==========
# 每次抓取约消耗 100 credits；下列阈值用于前端按余额变色提示续费
# TWITTER_BALANCE_WARNING_THRESHOLD=50000  # 黄色（约 2 天用量）
# TWITTER_BALANCE_DANGER_THRESHOLD=10000   # 红色（约半天用量）
