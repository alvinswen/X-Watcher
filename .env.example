# ============================================================
# X-watcher 环境配置
# ============================================================

# ========== X 平台 API 配置 ==========
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_BASE_URL=https://api.twitterapi.io/twitter

# ========== 抓取器配置 ==========
SCRAPER_LIMIT=30
# scraper_max_pages_per_scrape：常规增量抓取单次单账号最大页数硬上限（每页至多 20 条）
SCRAPER_MAX_PAGES_PER_SCRAPE=10

# ========== 数据层配置 ==========
# file 文件层（数据落 XWATCHER_DATA_ROOT；PostgreSQL 已于 2026-06-24 下线）
XWATCHER_DATA_ROOT=data_migrated

# ========== 日志配置 ==========
LOG_LEVEL=INFO

# ========== Prometheus 监控 ==========
PROMETHEUS_ENABLED=true

# ========== MCP Action Guard（动作级白名单 · 事前拦截）==========
# 按工具收紧允许的 action；留空或不设该变量 = 允许全部（行为不变），需收紧时取消注释并填值。
# 与 MCP_SCRAPE_ENABLED（整体开关）并存：任一拒绝即拒绝。
# manage_follows 合法 action：list,add,update,deactivate
# MCP_FOLLOWS_ALLOWED_ACTIONS=list,add,update,deactivate
# trigger_scrape / trigger_backfill 的 action 固定为 "scrape"（无 action 参数）；
# 收紧示例：设为不含 scrape 的值即禁用该工具的触发。
# MCP_TRIGGER_SCRAPE_ALLOWED_ACTIONS=scrape
# MCP_TRIGGER_BACKFILL_ALLOWED_ACTIONS=scrape
# MCP_CANDIDATE_SAMPLE_ALLOWED_ACTIONS=fetch

# ========== 管理员 API 配置 ==========
ADMIN_API_KEY=your_admin_api_key_here

# ========== JWT 认证配置 ==========
# 必填：留空启动会被强度校验拦下（禁默认值 / 非空 / >=32 字符）。
# 生成强随机密钥后填入：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24

# ========== Feed API 配置 ==========
FEED_MAX_TWEETS=200

# ========== TwitterAPI.io 余额告警阈值 ==========
# 返回推文按 15 credits/条计费；实测稳态日均约 4,050 credits
# TWITTER_BALANCE_WARNING_THRESHOLD=50000  # 黄色（约 12 天用量）
# TWITTER_BALANCE_DANGER_THRESHOLD=10000   # 红色（约 2.5 天用量）

# ========== 增量搜索抓取（CHG-054）==========
# SCRAPER_INCREMENTAL_ENABLED=false
# SCRAPER_INCREMENTAL_CUTOVER_GROUPS=
# SCRAPER_INCREMENTAL_OVERLAP_MINUTES=30
# SCRAPER_INCREMENTAL_MAX_ACCOUNTS_PER_GROUP=20
# SCRAPER_INCREMENTAL_MAX_QUERY_CHARS=450
# SCRAPER_INCREMENTAL_CLEAN_ROUNDS_REQUIRED=7
# SCRAPER_INCREMENTAL_STALLED_ROUNDS_ALERT=3
# SCRAPER_INCREMENTAL_SENTINELS=GaryMarcus,levelsio,elonmusk
# SCRAPER_INCREMENTAL_BRIDGE_TWEETS=100
# SCRAPER_INCREMENTAL_NEW_ACCOUNT_BACKFILL_TWEETS=200
# SCRAPER_INCREMENTAL_MAX_PAGES_PER_ROUND=25  # 每组每轮
# SCRAPER_INCREMENTAL_RESUME_ROUNDS_ALERT=10
