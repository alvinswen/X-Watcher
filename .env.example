# ============================================================
# X-watcher 环境配置
# ============================================================

# ========== X 平台 API 配置 ==========
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_BASE_URL=https://api.twitterapi.io/twitter

# ========== 抓取器配置 ==========
SCRAPER_ENABLED=true
SCRAPER_INTERVAL=43200
SCRAPER_USERNAMES=user1,user2,user3
SCRAPER_LIMIT=100

# ========== 数据层配置 ==========
# 默认 file 文件层（数据落 XWATCHER_DATA_ROOT；PostgreSQL 已于 2026-06-24 下线）
XWATCHER_DATA_LAYER=file
XWATCHER_DATA_ROOT=./data_migrated
# DATABASE_URL 仅 sqlalchemy 模式使用；file 模式不连 DB（保留 sqlite 仅作兜底）
DATABASE_URL=sqlite:///./news_agent.db

# ========== 日志配置 ==========
LOG_LEVEL=INFO

# ========== Prometheus 监控 ==========
PROMETHEUS_ENABLED=true

# ========== 管理员 API 配置 ==========
ADMIN_API_KEY=your_admin_api_key_here

# ========== JWT 认证配置 ==========
# 必填：留空启动会被强度校验拦下（禁默认值 / 非空 / >=32 字符）。
# 生成强随机密钥后填入：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=24

# ========== Feed API 配置 ==========
FEED_MAX_TWEETS=200

# ========== TwitterAPI.io 余额告警阈值 ==========
# 每次抓取约消耗 100 credits；下列阈值用于前端按余额变色提示续费
# TWITTER_BALANCE_WARNING_THRESHOLD=50000  # 黄色（约 2 天用量）
# TWITTER_BALANCE_DANGER_THRESHOLD=10000   # 红色（约半天用量）
